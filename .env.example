# Container Registry & Tag (fuer Portainer Stack auf ZimaOS)
REGISTRY_PREFIX=ghcr.io/smb04/file-converter
IMAGE_TAG=latest

# Netzwerk & Routing
APP_PORT=8095
ALLOWED_ORIGINS=*

# Ephemerer Buffer (RAM-basiert via tmpfs)
BUFFER_TMPFS_SIZE=2G
JOB_TTL_SECONDS=1200
MAX_FILE_BYTES=524288000
MAX_BATCH_BYTES=1073741824
BUFFER_HIGH_WATERMARK_PCT=80
BUFFER_REJECT_PCT=90

# Worker-Skalierung & Timeouts (ZimaOS / Intel N100 Standardwerte)
MEDIA_CONCURRENCY=2
DOCS_CONCURRENCY=2
IMAGE_TIMEOUT_SEC=30
DOC_TIMEOUT_SEC=60
VIDEO_TIMEOUT_SEC=900
MEDIA_CPU_LIMIT=3.0
MEDIA_MEM_LIMIT=2048M
DOCS_CPU_LIMIT=2.0
DOCS_MEM_LIMIT=1536M

# Optionale Hardware-Beschleunigung (Intel QuickSync / VAAPI via /dev/dri)
ENABLE_HW_ACCEL=false
RENDER_GID=109
